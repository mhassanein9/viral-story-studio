# Key from https://console.anthropic.com. Leave empty to run in offline template mode.
ANTHROPIC_API_KEY=
# Any current Claude model ID (see the Anthropic docs model list).
ANTHROPIC_MODEL=claude-sonnet-5-5
# Speaking rate used to estimate how long a line takes to say. 2.5 to 2.8 suits most narration.
WORDS_PER_SECOND=2.6
DEFAULT_DURATION=45
STUDIO_DB_PATH=data/studio.db
